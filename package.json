    "build:nomion": "turbo run build --filter nomion",
    "dev:nomion": "turbo run dev --filter nomion",
    "build:admin": "turbo run build --filter admin",
    "dev:admin": "turbo run dev --filter admin",
    "build:item": "turbo run build --filter item",
